{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapement/harness/schemas/executions.schema.json",
  "title": "DelegatedExecutionLedger",
  "description": "Per-parent native execution attempts and fenced leases; never Beads task state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "parent_session_id", "updated_at", "executions", "incidents"],
  "properties": {
    "version": {"const": 1},
    "parent_session_id": {"type": "string", "minLength": 1},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bead_id", "execution_id", "host", "agent_name", "native_child_id",
          "dispatch_tool_use_id", "attempt", "generation", "state", "queued_at",
          "started_at", "last_activity_at", "last_activity_kind", "start_deadline",
          "idle_deadline", "hard_deadline", "reconcile_due", "terminal_at",
          "terminal_reason", "terminal_event_id", "result_digest", "watchdog_id",
          "recovery_count", "recovery_claim", "result_application"
        ],
        "properties": {
          "bead_id": {"type": "string", "minLength": 1},
          "execution_id": {"type": "string", "minLength": 1},
          "host": {"type": "string", "minLength": 1},
          "agent_name": {"type": "string", "minLength": 1},
          "native_child_id": {"type": ["string", "null"]},
          "dispatch_tool_use_id": {"type": "string", "minLength": 1},
          "attempt": {"type": "integer", "minimum": 1},
          "generation": {"type": "integer", "minimum": 1},
          "state": {"type": "string", "enum": ["queued", "running", "terminal", "cancelled", "unknown"]},
          "queued_at": {"type": "string", "format": "date-time"},
          "started_at": {"type": ["string", "null"], "format": "date-time"},
          "last_activity_at": {"type": ["string", "null"], "format": "date-time"},
          "last_activity_kind": {"type": ["string", "null"]},
          "start_deadline": {"type": "string", "format": "date-time"},
          "idle_deadline": {"type": "string", "format": "date-time"},
          "hard_deadline": {"type": "string", "format": "date-time"},
          "reconcile_due": {"enum": ["start", "idle", "hard", null]},
          "terminal_at": {"type": ["string", "null"], "format": "date-time"},
          "terminal_reason": {"type": ["string", "null"]},
          "terminal_event_id": {"type": ["string", "null"]},
          "result_digest": {"type": ["string", "null"]},
          "watchdog_id": {"type": "string", "minLength": 1},
          "recovery_count": {"type": "integer", "minimum": 0},
          "recovery_claim": {"$ref": "#/$defs/recoveryClaim"},
          "result_application": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "claim", "claim_generation", "idempotency_key", "applied_at"],
            "properties": {
              "state": {"type": "string", "enum": ["unapplied", "applying", "applied"]},
              "claim": {"$ref": "#/$defs/applicationClaim"},
              "claim_generation": {"type": "integer", "minimum": 0},
              "idempotency_key": {"type": "string", "minLength": 1},
              "applied_at": {"type": ["string", "null"], "format": "date-time"}
            }
          }
        }
      }
    },
    "incidents": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "recoveryClaim": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "execution_id", "attempt", "generation", "claimed_at", "expires_at"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "execution_id": {"type": "string", "minLength": 1},
            "attempt": {"type": "integer", "minimum": 1},
            "generation": {"type": "integer", "minimum": 1},
            "claimed_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "applicationClaim": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "execution_id", "attempt", "generation", "claim_generation", "claimed_at", "expires_at"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "execution_id": {"type": "string", "minLength": 1},
            "attempt": {"type": "integer", "minimum": 1},
            "generation": {"type": "integer", "minimum": 1},
            "claim_generation": {"type": "integer", "minimum": 1},
            "claimed_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  }
}
